<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your Florence Home — Private Studios in Florence</title>
  <meta name="description" content="Three private furnished studios at Via dell'Albero 16, Florence. €1,200/month, all bills included. Available from November 2026.">
  <meta name="theme-color" content="#12273a">
  <style>
    :root{
      --navy:#12273a; --terracotta:#b25c43; --gold:#ddad4e;
      --cream:#f8f4ec; --ink:#2a3034; --muted:#6d6d6d; --white:#fff;
      --max:1180px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--cream);line-height:1.55}
    a{text-decoration:none;color:inherit}
    img{display:block;width:100%;height:100%;object-fit:cover}
    .container{width:min(var(--max),calc(100% - 40px));margin:auto}
    .eyebrow{letter-spacing:.14em;text-transform:uppercase;font-size:.78rem;font-weight:700;color:var(--terracotta)}
    h1,h2,h3{margin:0;line-height:1.05}
    h1{font-size:clamp(3.2rem,8vw,6.8rem);letter-spacing:-.045em}
    h2{font-size:clamp(2rem,4vw,3.7rem);letter-spacing:-.03em;color:var(--navy)}
    h3{font-size:1.55rem;color:var(--navy)}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 20px;border-radius:999px;font-weight:800;font-size:.86rem;letter-spacing:.03em}
    .btn-gold{background:var(--gold);color:var(--navy)}
    .btn-navy{background:var(--navy);color:var(--white)}
    .btn-outline{border:1px solid rgba(255,255,255,.45);color:#fff}
    header{position:absolute;z-index:5;left:0;right:0;padding:24px 0;color:#fff}
    nav{display:flex;justify-content:space-between;align-items:center}
    .brand{font-weight:800;letter-spacing:.08em;text-transform:uppercase}
    .navlinks{display:flex;gap:25px;font-size:.85rem;font-weight:700}
    .navlinks a{opacity:.92}
    .hero{min-height:92vh;display:grid;grid-template-columns:1fr 1fr;background:var(--navy);color:#fff}
    .hero-copy{display:flex;align-items:center;padding:110px max(30px,calc((100vw - var(--max))/2)) 70px max(30px,calc((100vw - var(--max))/2))}
    .hero-copy-inner{max-width:570px}
    .hero h1{color:#fff;margin:12px 0 20px}
    .hero-sub{font-size:1.25rem;max-width:500px;margin:0 0 28px;color:#e9e4da}
    .chips{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 30px}
    .chip{padding:9px 13px;border-radius:999px;background:rgba(255,255,255,.1);font-size:.82rem;font-weight:700}
    .hero-photo{min-height:650px}
    section{padding:92px 0}
    .section-head{max-width:760px;margin-bottom:42px}
    .section-head p{font-size:1.08rem;color:var(--muted);margin-top:14px}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .card{background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 12px 35px rgba(18,39,58,.08)}
    .card-photo{height:320px;position:relative}
    .tag{position:absolute;left:18px;bottom:18px;background:var(--navy);color:#fff;border-radius:999px;padding:8px 13px;font-size:.75rem;font-weight:800;letter-spacing:.08em}
    .card-body{padding:24px}
    .card-title{display:flex;justify-content:space-between;gap:15px;align-items:start}
    .price{color:var(--terracotta);font-weight:900;white-space:nowrap}
    .meta{color:var(--muted);font-size:.9rem;margin:12px 0 18px}
    .features{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:20px}
    .feature{background:var(--cream);padding:7px 9px;border-radius:9px;font-size:.76rem;font-weight:700}
    .split{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:stretch}
    .gallery{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:10px;min-height:510px}
    .gallery .big{grid-row:1 / span 2}
    .gallery img{border-radius:20px}
    .studio-copy{background:var(--white);border-radius:24px;padding:38px}
    .studio-copy p{color:var(--muted);font-size:1.03rem}
    .checklist{list-style:none;padding:0;margin:24px 0}
    .checklist li{padding:9px 0;border-bottom:1px solid #eee}
    .checklist li:last-child{border-bottom:0}
    .price-large{font-size:2.3rem;color:var(--terracotta);font-weight:900}
    .included{background:var(--navy);color:#fff}
    .included h2{color:#fff}
    .included .section-head p{color:#d8d5ce}
    .amenities{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .amenity{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.08);padding:25px;border-radius:18px}
    .amenity b{display:block;color:var(--gold);font-size:.78rem;letter-spacing:.1em;margin-bottom:8px}
    .location{display:grid;grid-template-columns:1fr 1fr;gap:25px}
    .location-card{background:#fff;border-radius:24px;padding:35px}
    .map-placeholder{min-height:350px;border-radius:24px;background:linear-gradient(135deg,#e8dfd2,#d8c9b6);display:grid;place-items:center;text-align:center;padding:30px;color:var(--navy)}
    .map-placeholder strong{font-size:1.4rem}
    .cta{background:var(--cream);padding-top:30px}
    .cta-box{background:var(--navy);color:#fff;border-radius:30px;padding:55px;display:flex;justify-content:space-between;align-items:center;gap:30px}
    .cta-box h2{color:#fff}
    .cta-box p{color:#d8d5ce;max-width:580px}
    footer{background:#0c1c2a;color:#cdd0d2;padding:28px 0;font-size:.82rem}
    .footer-row{display:flex;justify-content:space-between;gap:20px}
    @media(max-width:850px){
      .navlinks{display:none}
      .hero{grid-template-columns:1fr}
      .hero-photo{min-height:420px;order:-1}
      .hero-copy{padding:55px 20px 70px}
      .cards,.amenities,.location,.split{grid-template-columns:1fr}
      .gallery{min-height:430px}
      .cta-box,.footer-row{flex-direction:column;align-items:flex-start}
    }
    @media(max-width:520px){
      .container{width:min(var(--max),calc(100% - 28px))}
      section{padding:65px 0}
      .hero-copy{padding-left:14px;padding-right:14px}
      .gallery{grid-template-columns:1fr 1fr;min-height:330px}
      .gallery .big{grid-row:auto;grid-column:1 / span 2}
      .gallery .small1,.gallery .small2{height:130px}
      .cta-box{padding:34px 24px}
    }
  </style>
</head>
